{
  "name": "qbird",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-version.mjs && node --experimental-strip-types --test scripts/records-window-state.test.mjs scripts/more-menu.test.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:records-window": "node --experimental-strip-types --test scripts/records-window-state.test.mjs",
    "tauri": "tauri",
    "verify": "node scripts/check-version.mjs && node --experimental-strip-types --test scripts/records-window-state.test.mjs scripts/more-menu.test.mjs && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:more-menu": "node --experimental-strip-types --test scripts/more-menu.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,html,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.22.0"
}
